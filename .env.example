# Environment Variables Example Configuration
# -----------------------------------------------------------------------------
# Copy this file to .env.local to configure custom local settings if needed.
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS.

# Project & Deployment URLs
NEXT_PUBLIC_APP_URL=https://first-project-plum-phi.vercel.app
NEXT_PUBLIC_SITE_NAME="Khalid Abdullah // Digital Lab"

# Google Gemini API Key (Used in the AI CV Builder product)
# Obtain a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Analytics & Observability (Optional)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
# NEXT_PUBLIC_POSTHOG_KEY=

# Local Server Configuration
PORT=8080
HOST=localhost
