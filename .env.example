# ==============================================================================
# Trading OS Business Automation Engine — Environment Configuration
# ==============================================================================
# Copy this file to .env.local or .env in your deployment environment.
# NEVER COMMIT REAL CREDENTIALS, SECRETS, OR API KEYS TO SOURCE CONTROL.

# ------------------------------------------------------------------------------
# 1. Environment & Server Configuration
# ------------------------------------------------------------------------------
APP_ENV=development # Options: development | production | test
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
TRADING_OS_APP_URL=https://trading-os-blue.vercel.app

# ------------------------------------------------------------------------------
# 2. Neon PostgreSQL Database Connection (Production Source of Truth)
# Obtain connection string from your Neon Console (https://console.neon.tech)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. Google Gemini API (AI Intelligence Layer)
# Obtain key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
MOCK_GEMINI=false

# ------------------------------------------------------------------------------
# 4. Apollo API (Prospect Discovery & Enrichment Layer)
# Obtain key at: https://app.apollo.io/#/settings/integrations/api
# ------------------------------------------------------------------------------
APOLLO_API_KEY=your_apollo_api_key_here
APOLLO_BASE_URL=https://api.apollo.io/v1
MOCK_APOLLO=false

# ------------------------------------------------------------------------------
# 5. Instantly API & Webhooks (Cold Email Execution Layer)
# Obtain key at: https://app.instantly.ai/app/settings/integrations
# ------------------------------------------------------------------------------
INSTANTLY_API_KEY=your_instantly_api_key_here
INSTANTLY_BASE_URL=https://api.instantly.ai/api/v2
INSTANTLY_WEBHOOK_SECRET=your_instantly_webhook_signing_secret_here
MOCK_INSTANTLY=true # Keep true for safe sandbox testing

# ------------------------------------------------------------------------------
# 6. Private Dashboard Access
# ------------------------------------------------------------------------------
AUTH_TOKEN=your_private_access_secret_token
