{
  "name": "trading-os-business-automation",
  "version": "1.0.0",
  "description": "Production-grade AI-powered customer acquisition, lead qualification, and cold outreach engine for Trading OS",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "pipeline": "tsx workers/orchestrator.ts",
    "worker:discovery": "tsx workers/lead-discovery/index.ts",
    "worker:research": "tsx workers/lead-research/index.ts",
    "worker:scoring": "tsx workers/lead-scoring/index.ts",
    "worker:outreach": "tsx workers/outreach-generation/index.ts",
    "worker:sync": "tsx workers/instantly-sync/index.ts",
    "worker:replies": "tsx workers/reply-analysis/index.ts",
    "worker:analytics": "tsx workers/analytics/index.ts",
    "db:migrate": "tsx database/migrate.ts",
    "db:seed": "tsx database/seed/dev_seed.ts",
    "api:dev": "tsx apps/api/src/server.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^10.1.3",
    "@google/generative-ai": "^0.24.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "keywords": [
